{
  "name": "taskflow-root",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "start": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml}\"",
    "db:init": "pnpm --filter @taskflow/api db:init",
    "db:migrate": "pnpm --filter @taskflow/api migrate:up",
    "db:rollback": "pnpm --filter @taskflow/api migrate:down",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
