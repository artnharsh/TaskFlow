# ==============================================================================
# TaskFlow Backend Environment Configuration
# All variables below are MANDATORY. Missing variables will halt server boot.
# ==============================================================================

# Server HTTP Port
# Example: 8000
PORT=8000

# Client Application URL (used for CORS policy and Socket.IO origin authorization)
# Example: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Format: postgresql://<username>:<password>@<hostname>:<port>/<database_name>
# Example: postgresql://postgres:postgres@localhost:5432/taskflow
DATABASE_URL=postgresql://postgres:password@localhost:5432/taskflow

# Cryptographic Secret Key for signing and verifying JWT authentication tokens
# In production, use a strong random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_here

# ==============================================================================
# Provider-Agnostic AI Engine Configuration
# ==============================================================================

# Primary AI Provider Engine
# Supported choices: 'gemini' (Google GenAI Cloud) | 'ollama' (Local Self-Hosted)
AI_PROVIDER=gemini

# LLM Model Identifier
# Examples for Gemini: 'gemini-2.5-flash', 'gemini-2.0-flash', 'gemini-1.5-pro'
# Examples for Ollama: 'qwen2.5', 'llama3.2', 'mistral'
AI_MODEL=gemini-2.5-flash

# API Secret Key for Cloud AI Service
# MANDATORY if AI_PROVIDER is set to 'gemini', 'openai', or 'anthropic'
# Leave blank if using local Ollama
AI_API_KEY=your_google_ai_studio_api_key_here

# Local LLM Host Endpoint Base URL
# MANDATORY if AI_PROVIDER is set to 'ollama' or 'local'
# Default Ollama Endpoint: http://localhost:11434
AI_HOST=http://localhost:11434