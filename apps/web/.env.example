# ==============================================================================
# TaskFlow Frontend Environment Configuration
# All variables below are MANDATORY. Missing variables will halt runtime execution.
# ==============================================================================

# Backend REST API Endpoint Base URL (including /api path prefix)
# Example: http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Backend Real-Time WebSocket Origin Server Base URL
# Example: http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000
